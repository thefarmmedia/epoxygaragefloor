# Copy this file to .env — these are AGENCY-WIDE settings shared by every
# client dashboard. Per-client API keys (CompanyCam, BrightLocal, Facebook,
# Google, GoHighLevel, NAP) live in clients/<slug>.env instead — copy
# clients/_example.env.example to set up a new client.

# Port the server runs on
PORT=3000

# Anthropic (Claude) — powers real, per-job AI captions in the auto-poster panel.
# Without this, auto-poster still works, just with rotating templates instead.
# Get a key: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Resend — powers the monthly branded email report (manual button + auto-send
# on the 1st of every month). Get a free key: resend.com -> API Keys. You'll
# also need to verify a sending domain/address there for REPORT_FROM_EMAIL
# (set per-client, since each client's report should come from their own name).
RESEND_API_KEY=
