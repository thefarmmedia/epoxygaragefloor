# Copy this file to .env and fill in your keys.

# CompanyCam access token
# Get it: CompanyCam web app -> Company Settings -> Integrations -> Access Tokens
# (You need the Admin role on your CompanyCam account.)
COMPANYCAM_TOKEN=

# BrightLocal API key
# Get it: BrightLocal -> Account Settings -> API Access
BRIGHTLOCAL_API_KEY=

# Optional: pin the dashboard to one specific rank-tracking campaign ID.
# Leave blank to use the first campaign on the account.
BRIGHTLOCAL_CAMPAIGN_ID=

# Optional: change the port the panel runs on
PORT=3000

# Facebook / Meta
# Get a long-lived token: developers.facebook.com -> your app -> Graph API Explorer
# Scopes needed: ads_read, pages_read_engagement (add pages_manage_posts to publish)
FB_ACCESS_TOKEN=
# Ad account ID, numbers only (no "act_" prefix) — find it in Ads Manager URL
FB_AD_ACCOUNT_ID=
# Facebook page ID (for scheduled posts) — Page -> About -> Page transparency
FB_PAGE_ID=

# Google Business Profile (OAuth refresh-token flow, see README)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_LOCATION_ID=
GBP_ACCOUNT_ID=
