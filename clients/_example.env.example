# Per-client secrets. Copy this file to clients/<slug>.env (the slug must match
# the "slug" field for this client in clients.json) and fill in what you have —
# every integration falls back to demo data independently, so connect them one
# at a time in whatever order is easiest.

# CompanyCam access token
# Get it: CompanyCam web app -> Company Settings -> Integrations -> Access Tokens
# (Admin role required.)
COMPANYCAM_TOKEN=

# BrightLocal API key (shared by the rankings, citations, and geo-grid panels)
# Get it: BrightLocal -> Account Settings -> API Access
BRIGHTLOCAL_API_KEY=
# Pin to one rank-tracking campaign. Leave blank to use the first on the account.
BRIGHTLOCAL_CAMPAIGN_ID=
# BrightLocal Citation Tracker report ID (from the report's dashboard URL)
BRIGHTLOCAL_CT_REPORT_ID=
# Keyword label shown on the geo-grid demo (cosmetic only — see lib/geogrid.js)
BRIGHTLOCAL_GRID_KEYWORD=

# NAP (Name, Address, Phone, Website) — the single source of truth every
# citation must match exactly.
NAP_NAME=
NAP_ADDRESS=
NAP_PHONE=
NAP_WEBSITE=

# Facebook / Meta
# Get a long-lived token: developers.facebook.com -> your app -> Graph API Explorer
# Scopes needed: ads_read, pages_read_engagement (add pages_manage_posts to publish)
FB_ACCESS_TOKEN=
# Ad account ID, numbers only (no "act_" prefix) — find it in Ads Manager URL
FB_AD_ACCOUNT_ID=
# Facebook page ID (for scheduled posts) — Page -> About -> Page transparency
FB_PAGE_ID=

# Google Business Profile + Website (GA4) — OAuth refresh-token flow, see README.
# One refresh token covers both panels if the consent flow included both scopes:
# business.manage and analytics.readonly
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_LOCATION_ID=
GBP_ACCOUNT_ID=
GA4_PROPERTY_ID=

# GoHighLevel — Settings -> Private Integrations -> Create Integration
# Scopes needed: calendars.readonly (install schedule), opportunities.readonly (pipeline)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
# Optional: pin the pipeline panel to one pipeline. Leave blank for the first one.
GHL_PIPELINE_ID=

# Material ordering math — match your supplier's spec sheets.
BASE_COAT_SQFT_PER_KIT=450
FLAKE_LBS_PER_SQFT=0.2
TOPCOAT_SQFT_PER_KIT=500

# Monthly email report (requires agency-wide RESEND_API_KEY in the root .env)
REPORT_TO_EMAIL=
REPORT_FROM_EMAIL=
